# MO-EX environment configuration
# Copy this file to backend/.env and fill in real values.

# ---------------------------------------------------------------------------
# PostgreSQL (Docker Compose)
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_DB=moex
POSTGRES_USER=moex
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Optional: override auto-built URL
# DATABASE_URL=postgresql://moex:CHANGE_ME@db:5432/moex

# ---------------------------------------------------------------------------
# Data providers
# ---------------------------------------------------------------------------
ALOR_REFRESH_TOKEN=your_alor_refresh_token_here
ALOR_EXCHANGE=MOEX
ALOR_API_URL=https://api.alor.ru
ALOR_OAUTH_URL=https://oauth.alor.ru

# Legacy Finam (optional, Alor is used by default)
FINAM_TOKEN=
FINAM_CLIENT_ID=

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
